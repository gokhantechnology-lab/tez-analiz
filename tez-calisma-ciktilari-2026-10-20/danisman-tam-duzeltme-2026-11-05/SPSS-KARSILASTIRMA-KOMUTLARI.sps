 /SCALE('PC_F3_PRE') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
RELIABILITY /VARIABLES=PC_PRE_M01 PC_PRE_M02 PC_PRE_M03 PC_PRE_M04 PC_PRE_M05 PC_PRE_M06 PC_PRE_M07 PC_PRE_M08 PC_PRE_M09 PC_PRE_M10 PC_PRE_M11 PC_PRE_M12 PC_PRE_M13 PC_PRE_M14 PC_PRE_M15 PC_PRE_M16 PC_PRE_M17 PC_PRE_M18 PC_PRE_M19 PC_PRE_M20 PC_PRE_M21 PC_PRE_M22 PC_PRE_M23 PC_PRE_M24 PC_PRE_M25 PC_PRE_M26 PC_PRE_M27 PC_PRE_M28 PC_PRE_M29 PC_PRE_M30 PC_PRE_M31 PC_PRE_M32 PC_PRE_M33 PC_PRE_M34 PC_PRE_M35
 /SCALE('PC_TOTAL_PRE') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
RELIABILITY /VARIABLES=PC_POST_M01 PC_POST_M02 PC_POST_M03 PC_POST_M04 PC_POST_M11 PC_POST_M19 PC_POST_M20 PC_POST_M23 PC_POST_M24 PC_POST_M27 PC_POST_M33
 /SCALE('PC_F1_POST') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
RELIABILITY /VARIABLES=PC_POST_M05 PC_POST_M07 PC_POST_M08 PC_POST_M13 PC_POST_M14 PC_POST_M15 PC_POST_M16 PC_POST_M17 PC_POST_M21 PC_POST_M25 PC_POST_M26 PC_POST_M28 PC_POST_M30 PC_POST_M31 PC_POST_M32 PC_POST_M35
 /SCALE('PC_F2_POST') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
RELIABILITY /VARIABLES=PC_POST_M06 PC_POST_M10 PC_POST_M18 PC_POST_M29 PC_POST_M34
 /SCALE('PC_F3_POST') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
RELIABILITY /VARIABLES=PC_POST_M01 PC_POST_M02 PC_POST_M03 PC_POST_M04 PC_POST_M05 PC_POST_M06 PC_POST_M07 PC_POST_M08 PC_POST_M09 PC_POST_M10 PC_POST_M11 PC_POST_M12 PC_POST_M13 PC_POST_M14 PC_POST_M15 PC_POST_M16 PC_POST_M17 PC_POST_M18 PC_POST_M19 PC_POST_M20 PC_POST_M21 PC_POST_M22 PC_POST_M23 PC_POST_M24 PC_POST_M25 PC_POST_M26 PC_POST_M27 PC_POST_M28 PC_POST_M29 PC_POST_M30 PC_POST_M31 PC_POST_M32 PC_POST_M33 PC_POST_M34 PC_POST_M35
 /SCALE('PC_TOTAL_POST') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
