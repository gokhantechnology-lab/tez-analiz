* Hipotez testleri cift yonlu; fark yonu son eksi on.
T-TEST PAIRS=PC_F1_POST PC_F2_POST PC_F3_POST PC_TOTAL_POST IB_F1_POST IB_F2_POST IB_F3_POST IB_F4_POST IB_TOTAL_POST
 WITH PC_F1_PRE PC_F2_PRE PC_F3_PRE PC_TOTAL_PRE IB_F1_PRE IB_F2_PRE IB_F3_PRE IB_F4_PRE IB_TOTAL_PRE (PAIRED)
 /CRITERIA=CI(.95) /MISSING=ANALYSIS.
EXAMINE VARIABLES=D_PC_F1 D_PC_F2 D_PC_F3 D_PC_TOTAL D_IB_F1 D_IB_F2 D_IB_F3 D_IB_F4 D_IB_TOTAL
 /PLOT=NPPLOT /STATISTICS=DESCRIPTIVES /CINTERVAL=95 /MISSING=LISTWISE /NOTOTAL.
RELIABILITY /VARIABLES=PC_PRE_M01 PC_PRE_M02 PC_PRE_M03 PC_PRE_M04 PC_PRE_M11 PC_PRE_M19 PC_PRE_M20 PC_PRE_M23 PC_PRE_M24 PC_PRE_M27 PC_PRE_M33
 /SCALE('PC_F1_PRE') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
RELIABILITY /VARIABLES=PC_PRE_M05 PC_PRE_M07 PC_PRE_M08 PC_PRE_M13 PC_PRE_M14 PC_PRE_M15 PC_PRE_M16 PC_PRE_M17 PC_PRE_M21 PC_PRE_M25 PC_PRE_M26 PC_PRE_M28 PC_PRE_M30 PC_PRE_M31 PC_PRE_M32 PC_PRE_M35
