* ILETISIM ANALIZLERI.
CD 'C:/TEZ_SPSS'.
GET FILE='TEZ40.sav'.
EXAMINE VARIABLES=D_IB_F1 D_IB_F2 D_IB_F3 D_IB_F4 D_IB_TOTAL
 /PLOT=NPPLOT /STATISTICS=DESCRIPTIVES /CINTERVAL=95 /MISSING=LISTWISE /NOTOTAL.
RELIABILITY /VARIABLES=IB_PRE_M01 IB_PRE_M03 IB_PRE_M06 IB_PRE_M13 IB_PRE_M15 IB_PRE_M16 IB_PRE_M21 IB_PRE_M23 IB_PRE_M24 IB_PRE_M25
 /SCALE('IB_F1_PRE') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
RELIABILITY /VARIABLES=IB_PRE_M02 IB_PRE_M05 IB_PRE_M17 IB_PRE_M20
 /SCALE('IB_F2_PRE') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
RELIABILITY /VARIABLES=IB_PRE_M10 IB_PRE_M11 IB_PRE_M12 IB_PRE_M18 IB_PRE_M19 IB_PRE_M22
 /SCALE('IB_F3_PRE') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
RELIABILITY /VARIABLES=IB_PRE_M04 IB_PRE_M07 IB_PRE_M08 IB_PRE_M09 IB_PRE_M14
 /SCALE('IB_F4_PRE') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
RELIABILITY /VARIABLES=IB_PRE_M01 IB_PRE_M02 IB_PRE_M03 IB_PRE_M04 IB_PRE_M05 IB_PRE_M06 IB_PRE_M07 IB_PRE_M08 IB_PRE_M09 IB_PRE_M10 IB_PRE_M11 IB_PRE_M12 IB_PRE_M13 IB_PRE_M14 IB_PRE_M15 IB_PRE_M16 IB_PRE_M17 IB_PRE_M18 IB_PRE_M19 IB_PRE_M20 IB_PRE_M21 IB_PRE_M22 IB_PRE_M23 IB_PRE_M24 IB_PRE_M25
 /SCALE('IB_TOTAL_PRE') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
RELIABILITY /VARIABLES=IB_POST_M01 IB_POST_M03 IB_POST_M06 IB_POST_M13 IB_POST_M15 IB_POST_M16 IB_POST_M21 IB_POST_M23 IB_POST_M24 IB_POST_M25
 /SCALE('IB_F1_POST') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
RELIABILITY /VARIABLES=IB_POST_M02 IB_POST_M05 IB_POST_M17 IB_POST_M20
 /SCALE('IB_F2_POST') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
RELIABILITY /VARIABLES=IB_POST_M10 IB_POST_M11 IB_POST_M12 IB_POST_M18 IB_POST_M19 IB_POST_M22
 /SCALE('IB_F3_POST') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
RELIABILITY /VARIABLES=IB_POST_M04 IB_POST_M07 IB_POST_M08 IB_POST_M09 IB_POST_M14
 /SCALE('IB_F4_POST') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
RELIABILITY /VARIABLES=IB_POST_M01 IB_POST_M02 IB_POST_M03 IB_POST_M04 IB_POST_M05 IB_POST_M06 IB_POST_M07 IB_POST_M08 IB_POST_M09 IB_POST_M10 IB_POST_M11 IB_POST_M12 IB_POST_M13 IB_POST_M14 IB_POST_M15 IB_POST_M16 IB_POST_M17 IB_POST_M18 IB_POST_M19 IB_POST_M20 IB_POST_M21 IB_POST_M22 IB_POST_M23 IB_POST_M24 IB_POST_M25
 /SCALE('IB_TOTAL_POST') ALL /MODEL=ALPHA /SUMMARY=TOTAL.
T-TEST PAIRS=IB_F1_POST IB_F2_POST IB_F3_POST IB_F4_POST IB_TOTAL_POST
 WITH IB_F1_PRE IB_F2_PRE IB_F3_PRE IB_F4_PRE IB_TOTAL_PRE (PAIRED)
 /CRITERIA=CI(.95) /MISSING=ANALYSIS.
NPAR TESTS /WILCOXON=IB_F2_POST IB_F4_POST WITH IB_F2_PRE IB_F4_PRE (PAIRED) /MISSING=ANALYSIS.
* Output penceresinde File > Save As ile gercek ciktiyi .spv olarak kaydedin.
